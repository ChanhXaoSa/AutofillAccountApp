<Window x:Class="WpfAppLayer.ManagerAccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfAppLayer"
        mc:Ignorable="d"
        Title="Quản lí tài khoản" Height="400" Width="500">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ListBox x:Name="AccountList" Grid.Row="0" Margin="0,0,0,10">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding DisplayName}" Margin="0,0,10,0"/>
                        <TextBlock Text="{Binding Username}"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="AddButton" Content="Thêm" Width="80" Margin="0,0,10,0" Click="AddButton_Click"/>
            <Button x:Name="EditButton" Content="Sửa" Width="80" Margin="0,0,10,0" Click="EditButton_Click"/>
            <Button x:Name="DeleteButton" Content="Xóa" Width="80" Margin="0,0,10,0" Click="DeleteButton_Click"/>
            <Button x:Name="CloseButton" Content="Đóng" Width="80" Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
