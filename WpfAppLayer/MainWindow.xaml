<Window x:Class="WpfAppLayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfAppLayer"
        mc:Ignorable="d"
        Title="Auto Login" Height="300" Width="400">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Label Content="Chọn tài khoản: " Grid.Row="0"/>
        <ComboBox x:Name="AccountComboBox" Grid.Row="1" Margin="0, 5, 0, 10"
          DisplayMemberPath="DisplayName"
          SelectionChanged="AccountComboBox_SelectionChanged"/>
        <Button x:Name="LoginButton" Content="Đăng nhập" Grid.Row="2"
        Click="LoginButton_Click" Width="100" Height="30"/>
        <Button x:Name="SetPositionButton" Content="Đặt vị trí Username" Grid.Row="3"
                Click="SetPositionButton_Click" Width="150" Height="30" IsEnabled="False"/>
    </Grid>
</Window>
